{
  "name": "inventory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:studio": "drizzle-kit studio --config drizzle.tenant.config.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:reset": "pnpm db:migrate && pnpm db:seed",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && drizzle-kit generate --config drizzle.tenant.config.ts",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:backup": "tsx --env-file=.env src/db/backup.ts",
    "carriers:sync": "tsx --conditions=react-server --env-file=.env src/db/carriers-sync.ts",
    "shops:sync": "tsx --conditions=react-server --env-file=.env src/db/shops-sync.ts",
    "orgs:purge": "tsx --conditions=react-server --env-file=.env src/db/purge.ts",
    "db:euro": "tsx --conditions=react-server --env-file=.env src/db/euro.ts",
    "notify:digest": "tsx --conditions=react-server --env-file=.env src/db/digest.ts",
    "db:pool:add": "tsx --env-file=.env src/db/pool-add.ts",
    "platform-admin": "tsx --env-file=.env src/db/platform-admin.ts"
  },
  "dependencies": {
    "bwip-js": "^4.11.4",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.3",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.59.0",
    "mysql2": "^3.24.6",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.11.0"
}
