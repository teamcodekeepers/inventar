# Домейн (host:port), на който работи приложението. Клиентите са на <поддомейн>.APP_DOMAIN
APP_DOMAIN=localhost:3000
# APP_PROTOCOL=https
# Случаен низ за криптиране на пароли от пула и подписи (openssl rand -hex 32)
APP_SECRET=change-me-please

# Контролна база (организации, потребители, сесии)
CONTROL_DATABASE_URL=mysql://inventory:inventory@localhost:3306/inventory_control
# Администраторска връзка за CREATE DATABASE (режим auto)
TENANT_DB_ADMIN_URL=mysql://inventory:inventory@localhost:3306
# auto = CREATE DATABASE за всяка организация; manual = пул от готови бази (pnpm db:pool:add)
TENANT_DB_MODE=auto
TENANT_DB_PREFIX=inv_
# Демо режим: целият сайт е една организация (този поддомейн), без *.APP_DOMAIN — за хостинг без wildcard
# поддомейни. Порталът, регистрацията и /admin не се ползват.
# DEMO_TENANT=demo
# Само за drizzle-kit (генериране на миграции)
TENANT_TEMPLATE_DATABASE_URL=mysql://inventory:inventory@localhost:3306/inv__template

# Имейл (SMTP). Без SMTP_HOST писмата се печатат в конзолата на сървъра.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Инвентар <no-reply@example.com>"

# Качени файлове (снимки на артикули). По подразбиране ./storage — включете папката в архивите.
# STORAGE_DIR=/home/user/inventar-storage

# --- Работа в production
# Миграции при стартиране на сървъра (контролна + всички клиентски бази). 0 = изключено.
AUTO_MIGRATE=1
# debug | info | warn | error — логът е JSON по един ред в stdout/stderr
LOG_LEVEL=info
# По избор: грешките се изпращат и към Sentry
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# Показва се в /api/health (напр. git SHA от деплоя)
# APP_COMMIT=
# REST API: заявки в минута на ключ
# API_RATE_LIMIT=600

# ---- Абонаменти: адрес за връзка в Настройки › Абонамент (докато няма онлайн плащане)
# PLATFORM_CONTACT_EMAIL=sales@your-domain.bg

# ---- Правни страници (/terms, /privacy, /dpa, /cookies): данни на оператора на платформата.
# Докато не са попълнени, страниците показват [ПОЛЕ] и надпис „чернова“. Прегледайте текстовете с юрист.
# LEGAL_COMPANY_NAME=
# LEGAL_COMPANY_EIK=
# LEGAL_COMPANY_ADDRESS=
# LEGAL_CONTACT_EMAIL=
# LEGAL_DPO_EMAIL=
# LEGAL_HOSTING=Hostinger, дейта център в ЕС (Литва)
